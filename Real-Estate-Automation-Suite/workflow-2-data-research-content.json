    {
      "id": "ai-extract-info",
      "name": "AI Extract Information from Fetched Data",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [1260, 260],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.rawData }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a data extraction AI for real estate market analysis. Extract and structure the following information from the provided data.\n\nRespond with valid JSON containing:\n{\n  \"extractedItems\": [\n    {\n      \"title\": \"Item title or name\",\n      \"category\": \"market_trend | property_listing | news | statistic\",\n      \"summary\": \"Brief summary\",\n      \"keyMetrics\": {},\n      \"relevanceScore\": 0-100\n    }\n  ],\n  \"overallSummary\": \"High-level summary of all data\",\n  \"dataQuality\": \"high | medium | low\",\n  \"processingNotes\": \"Any issues or observations\"\n}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "llm-extractor",
      "name": "LLM for Data Information Extractor",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [1260, 460],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "options": {
          "responseFormat": "json_object",
          "temperature": 0.2
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "placeholder-openai",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "parse-extraction",
      "name": "Parse Extracted Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1480, 260],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse AI extraction output\nconst prevData = $('Set Fetched Data').item.json;\nlet extractedData;\n\ntry {\n  extractedData = JSON.parse($json.text);\n} catch (e) {\n  extractedData = { error: 'Failed to parse AI response', raw: $json.text };\n}\n\nreturn {\n  fetchedAt: prevData.fetchedAt,\n  extraction: extractedData,\n  itemCount: extractedData.extractedItems?.length || 0,\n  overallSummary: extractedData.overallSummary || '',\n  dataQuality: extractedData.dataQuality || 'unknown'\n};"
      }
    },
    {
      "id": "ai-research-agent",
      "name": "AI Agent for Research & Content Generation",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [1700, 260],
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this extracted real estate data and generate comprehensive insights:\n\nData Summary: {{ $json.overallSummary }}\nItem Count: {{ $json.itemCount }}\nData Quality: {{ $json.dataQuality }}\n\nExtracted Items: {{ JSON.stringify($json.extraction.extractedItems || []) }}\n\nTasks:\n1. Identify the most significant market trends\n2. Calculate any relevant statistics or comparisons\n3. Search for additional context on major findings if needed\n4. Generate a comprehensive analysis report suitable for a real estate professional\n5. Provide actionable recommendations based on the data",
        "hasOutputParser": false,
        "options": {
          "maxIterations": 10,
          "systemMessage": "You are an expert real estate market analyst AI. Your role is to analyze market data, identify trends, and generate actionable insights for real estate professionals. Use the calculator tool for numerical analysis and the web search tool to gather additional market context when needed. Provide clear, professional analysis with specific recommendations."
        }
      }
    },
    {
      "id": "llm-research-agent",
      "name": "LLM for Research & Content AI Agent",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
